{
  "name": "sinsin-rn-temp",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:test": "node scripts/with-env.js .env.test -- expo start -c",
    "start:prod": "node scripts/with-env.js .env.production -- expo start -c",
    "android": "expo run:android",
    "android:test": "node scripts/with-env.js .env.test -- expo run:android",
    "android:prod": "node scripts/with-env.js .env.production -- expo run:android",
    "ios": "expo run:ios",
    "ios:test": "node scripts/with-env.js .env.test -- expo run:ios",
    "ios:prod": "node scripts/with-env.js .env.production -- expo run:ios",
    "ios-release": "expo prebuild --platform ios --clean && expo run:ios --configuration Release",
    "ios-no-user": "EXPO_PUBLIC_MOCK_NO_USER=true expo run:ios",
    "web": "expo start --web",
    "build:test": "npm run build:test:android && npm run build:test:ios",
    "build:test:ios": "eas build --platform ios --profile ios-testflight-test",
    "build:test:android": "eas build --platform android --profile test",
    "build:prod": "eas build --platform all --profile production",
    "build:prod:ios": "eas build --platform ios --profile testflight",
    "build:prod:android": "eas build --platform android --profile playstore",
    "deploy": "eas build --platform all --profile production --auto-submit",
    "deploy:prod": "eas build --platform all --profile production --auto-submit",
    "deploy:ios": "eas build --platform ios --profile testflight --auto-submit-with-profile testflight",
    "deploy:android": "eas build --platform android --profile playstore --auto-submit-with-profile playstore",
    "test:api:test": "node scripts/with-env.js .env.test -- jest --config jest.config.ts tests/",
    "test:api:prod": "node scripts/with-env.js .env.production -- jest --config jest.config.ts tests/",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "design:export": "ts-node --project scripts/design-system/tsconfig.json scripts/design-system/export.ts",
    "design:sync": "npm run design:export && node scripts/design-system/sync.js",
    "test:api": "jest --config jest.config.ts tests/",
    "test:api:auth": "jest --config jest.config.ts tests/auth.test.ts",
    "test:api:food": "jest --config jest.config.ts tests/food.test.ts",
    "test:api:chat": "jest --config jest.config.ts tests/chat.test.ts",
    "test:api:profile": "jest --config jest.config.ts tests/profile.test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-kakao/core": "^2.4.5",
    "@react-native-kakao/user": "^2.4.5",
    "@react-native-menu/menu": "^2.0.0",
    "@tamagui/animations-react-native": "2.0.0-rc.6",
    "@tamagui/config": "2.0.0-rc.6",
    "@tamagui/core": "2.0.0-rc.6",
    "@tamagui/dialog": "2.0.0-rc.6",
    "@tamagui/lucide-icons": "2.0.0-rc.6",
    "@tamagui/portal": "2.0.0-rc.6",
    "@tamagui/sheet": "2.0.0-rc.6",
    "@tanstack/react-query": "5.90.20",
    "axios": "1.13.5",
    "eas": "^0.1.0",
    "expo": "^55.0.11",
    "expo-apple-authentication": "~55.0.11",
    "expo-build-properties": "~55.0.11",
    "expo-camera": "~55.0.13",
    "expo-clipboard": "~55.0.11",
    "expo-constants": "~55.0.11",
    "expo-dev-client": "~55.0.22",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.8",
    "expo-image-manipulator": "~55.0.13",
    "expo-image-picker": "~55.0.16",
    "expo-linear-gradient": "~55.0.11",
    "expo-linking": "~55.0.11",
    "expo-localization": "~55.0.16",
    "expo-location": "~55.1.6",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.10",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.16",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "i18next": "^26.3.4",
    "lodash-es": "^4.17.23",
    "mixpanel-react-native": "^3.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.71.1",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-ios-context-menu": "3.2.1",
    "react-native-ios-utilities": "5.2.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-share": "^12.2.6",
    "react-native-svg": "15.15.3",
    "react-native-svg-transformer": "1.5.3",
    "react-native-teleport": "1.0.0",
    "react-native-toast-message": "2.3.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "tamagui": "2.0.0-rc.6",
    "zeego": "^3.0.6",
    "zustand": "5.0.11"
  },
  "overrides": {
    "markdown-it": "^14.1.0",
    "react-native-ios-context-menu": "3.2.1",
    "react-native-ios-utilities": "5.2.0",
    "zeego": {
      "@react-native-menu/menu": "$@react-native-menu/menu"
    }
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/jest": "29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "~19.2.10",
    "dotenv": "^17.3.1",
    "eslint": "9.39.2",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "form-data": "^4.0.5",
    "husky": "9.1.7",
    "jest": "~29.7.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
