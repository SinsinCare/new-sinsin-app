{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // 앱 코드가 findLast/findLastIndex(ES2023)를 씁니다. Hermes·Node 모두 있는
    // 메서드인데 lib 이 ES2020 이면 타입만 없어서 테스트 스위트가 통째로 죽습니다.
    "lib": ["ES2023"],
    // .tsx 를 import 하는 테스트(bottomSheetPicker 등)가 TS6142 로 통째로 죽습니다.
    // 앱 tsconfig 는 expo/tsconfig.base 에서 jsx 를 받지만 이 파일은 상속하지 않습니다.
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": ".jest-out"
  },
  // `src/types/svg.d.ts` 를 넣지 않으면 `.svg` 를 import 하는 `.tsx` 를 (전이적으로라도)
  // 들여오는 테스트가 TS2307 로 통째로 죽는다. 이 파일은 앱 tsconfig 를 상속하지 않으므로
  // 선언 파일을 여기서 직접 집어 줘야 한다(실측된 결함이다).
  "include": ["tests/**/*", "src/types/svg.d.ts"]
}
