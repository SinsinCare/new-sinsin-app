# Mock 모드
EXPO_PUBLIC_USE_MOCK_AUTH=false # mock auth (로그인/회원가입 API 우회)
EXPO_PUBLIC_USE_MOCK_MODE=false # mock data (온보딩 등 데이터 서비스 우회)
EXPO_PUBLIC_MOCK_NO_USER=false  # mock 모드에서 유저 프로필 없이 실행

# Backend URL
EXPO_PUBLIC_BACKEND_URL=

# Mobile runtime policy environment: test or production
EXPO_PUBLIC_APP_ENV=test

# Analytics events are sent only to the first-party backend (/api/v1/analytics/batch).
# Mixpanel mirroring is server-owned so the app cannot double-count events.
EXPO_PUBLIC_ANALYTICS_DISABLED=false

# Food analysis follow-up questions (kept off until the confirmation UI is redesigned)
EXPO_PUBLIC_FOOD_ANALYSIS_CONFIRMATION_ENABLED=false

# Google Sign-In OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=IOS_CLIENT_ID.apps.googleusercontent.com

# KAKAO_PLATFORM_KEY
EXPO_PUBLIC_KAKAO_JS_KEY=SDK_JS_KEY

# 지도 WebView 문서 주소. **카카오 개발자 콘솔의 Web 플랫폼 사이트 도메인과 정확히 같아야
# 한다** — 다르면 SDK 가 401 을 주고 지도가 안 뜬다(호스트와 포트까지 본다).
# 개발에서는 비워도 된다(Metro 주소 https://localhost:8081 로 떨어진다).
# **릴리스 빌드에서는 비우면 지도가 설정 오류로 뜬다** — eas.json 의 각 프로필이 준다.
EXPO_PUBLIC_KAKAO_MAP_BASE_URL=
