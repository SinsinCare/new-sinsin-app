{
  "expo": {
    "name": "신신당부",
    "slug": "sinsin-rn",
    "version": "1.2.3",
    "orientation": "default",
    "icon": "./assets/branding/app_icon_260720.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "5",
      "bundleIdentifier": "com.mediology.sinsin-care",
      "appleTeamId": "HJJNV9Y5W8",
      "associatedDomains": [
        "applinks:sinsincare.kr"
      ],
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "신신당부",
        "CFBundleName": "신신당부",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "내 주변 식당을 찾으려면 앱을 사용하는 동안 위치 접근을 허용해 주세요.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram",
          "kakaokompassauth",
          "kakaolink",
          "kakaotalk"
        ],
        "NSMicrophoneUsageDescription": "사진 촬영 화면 구성에 필요한 항목으로, 마이크를 실제로 사용하지 않습니다."
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app_icon_260720.png",
        "backgroundColor": "#FFF5ED"
      },
      "package": "com.mediology.sinsinapp",
      "versionCode": 20,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sinsincare.kr",
              "pathPrefix": "/password-edit"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FE7139"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "음식 사진으로 식단을 기록하려면 카메라 접근을 허용해 주세요.",
          "microphonePermission": "사진 촬영 화면 구성에 필요한 항목으로, 마이크를 실제로 사용하지 않습니다.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앨범의 음식 사진으로 식단을 기록하려면 사진 접근을 허용해 주세요.",
          "microphonePermission": "사진 촬영 화면 구성에 필요한 항목으로, 마이크를 실제로 사용하지 않습니다."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.87899379852-eo6mf97djcrckpbqc748vcdcbl2m3ls4"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "709c22f6c6227095a316851f1f902189",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "kakaotalkLoginEnabled": true,
            "handleKakaoOpenUrl": true
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "deploymentTarget": "18.6",
            "appleTeamId": "HJJNV9Y5W8",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ],
            "configurations": {
              "Debug": {
                "prebuild": "Debug"
              },
              "Release": {
                "prebuild": "Release"
              }
            }
          },
          "android": {
            "newArchEnabled": true,
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ],
            "compileSdkVersion": 36,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# 카카오 SDK — 리플렉션으로 응답 DTO 를 채운다. 이름이 지워지면 로그인 응답 파싱이 죽는다.\n-keep class com.kakao.sdk.**.model.* { <fields>; }\n-keep class * extends com.google.gson.TypeAdapter\n# Google Sign-In / GMS — 내부에서 이름으로 찾는 클래스들.\n-keep class com.google.android.gms.** { *; }\n-dontwarn com.google.android.gms.**\n# 크래시 로그를 읽을 수 있게 줄 번호를 남긴다(매핑 파일과 짝).\n-keepattributes SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile\n# ── Retrofit × R8 풀모드 (2026-08-23) ─────────────────────────────────────\n# AGP 8 부터 `android.enableR8.fullMode` 기본값이 true 다. 풀모드는 **제네릭\n# 시그니처를 지운다.** 그러면 Retrofit 이 서비스 인터페이스의 반환 타입을 못 읽고\n# `DefaultCallAdapterFactory.get` 에서 IllegalArgumentException 을 던진다.\n#\n# 카카오 안드로이드 SDK 가 내부적으로 Retrofit 을 쓴다. 그래서 카카오 로그인을\n# 누르는 순간 SDK 의 첫 통신에서 앱이 죽었다 — 카톡으로 넘어가기 **전** 단계라\n# 사용자에게는 \"눌렀더니 앱이 꺼진다\" 로 보였다. Play Console 크래시가 이 스택\n# 하나로 100%, 8/9 부터. 같은 시점에 안드로이드 카카오 신규 가입이 0 이 됐다.\n#\n# iOS 는 멀쩡했다(카카오 iOS SDK 는 Retrofit 을 안 쓴다). 안드로이드 구글도\n# 멀쩡했다(그 경로를 안 탄다). 릴리스에서만 났다(축소는 릴리스에만 걸린다).\n#\n# Retrofit 이 AAR 에 담아 보내는 소비자 규칙만으로는 풀모드에서 부족하다 —\n# 아래 세 줄은 Retrofit 문서가 풀모드용으로 따로 요구하는 것이다.\n-keepattributes Signature, InnerClasses, EnclosingMethod\n-keepattributes RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations\n-keep,allowobfuscation,allowshrinking interface retrofit2.Call\n-keep,allowobfuscation,allowshrinking class retrofit2.Response\n-keep,allowobfuscation,allowshrinking class kotlin.coroutines.Continuation\n# 어노테이션이 붙은 서비스 메서드는 서술자까지 남긴다(파라미터 타입이 지워지면 같은 증상).\n-keepclasseswithmembers,includedescriptorclasses class * { @retrofit2.http.* <methods>; }\n"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 식당을 찾으려면 앱을 사용하는 동안 위치 접근을 허용해 주세요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ko",
              "en"
            ],
            "android": [
              "ko",
              "en"
            ]
          }
        }
      ]
    ],
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    },
    "scheme": "sinsin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd9b5694-69b9-43b8-bc38-f3c0c4366183"
      }
    },
    "owner": "mediologyadmin"
  }
}