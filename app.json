{
  "expo": {
    "name": "신신당부",
    "slug": "sinsin-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mediology.sinsin",
      "deploymentTarget": "14.0",
      "infoPlist": {
        "NSHealthShareUsageDescription": "건강 데이터를 읽어 맞춤형 건강 관리를 제공합니다.",
        "NSHealthUpdateUsageDescription": "건강 데이터를 기록합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.mediology.sinsin",
      "edgeToEdgeEnabled": true,
      "minSdkVersion": 23,
      "targetSdkVersion": 34,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HYDRATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "음식 사진을 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "음식 사진을 선택하기 위해 사진 접근이 필요합니다."
        }
      ],
      "expo-font"
    ],
    "scheme": "sinsin",
    "experiments": {
      "typedRoutes": true
    }
  }
}
