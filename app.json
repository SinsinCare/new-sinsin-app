{
  "expo": {
    "name": "신신당부",
    "slug": "sinsin-rn",
    "version": "1.1.6",
    "orientation": "default",
    "icon": "./assets/branding/app_icon_260720.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "4",
      "bundleIdentifier": "com.mediology.sinsin-care",
      "appleTeamId": "HJJNV9Y5W8",
      "associatedDomains": ["applinks:sinsincare.kr"],
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "신신당부",
        "CFBundleName": "신신당부",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "내 주변 식당을 찾으려면 앱을 사용하는 동안 위치 접근을 허용해 주세요.",
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram",
          "kakaokompassauth",
          "kakaolink",
          "kakaotalk"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app_icon_260720.png",
        "backgroundColor": "#D8E9F5"
      },
      "package": "com.mediology.sinsinapp",
      "versionCode": 19,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sinsincare.kr",
              "pathPrefix": "/password-edit"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5A5F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "음식 사진으로 식단을 기록하려면 카메라 접근을 허용해 주세요.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앨범의 음식 사진으로 식단을 기록하려면 사진 접근을 허용해 주세요.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.87899379852-eo6mf97djcrckpbqc748vcdcbl2m3ls4"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "709c22f6c6227095a316851f1f902189",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "kakaotalkLoginEnabled": true,
            "handleKakaoOpenUrl": true
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "deploymentTarget": "18.6",
            "appleTeamId": "HJJNV9Y5W8",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ],
            "configurations": {
              "Debug": {
                "prebuild": "Debug"
              },
              "Release": {
                "prebuild": "Release"
              }
            }
          },
          "android": {
            "newArchEnabled": true,
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "내 주변 식당을 찾으려면 앱을 사용하는 동안 위치 접근을 허용해 주세요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ko", "en"],
            "android": ["ko", "en"]
          }
        }
      ]
    ],
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json"
    },
    "scheme": "sinsin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd9b5694-69b9-43b8-bc38-f3c0c4366183"
      }
    },
    "owner": "mediologyadmin"
  }
}
