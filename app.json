{
  "expo": {
    "name": "신신당부",
    "slug": "sinsin-rn",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "4",
      "bundleIdentifier": "com.mediology.sinsin-care",
      "appleTeamId": "HJJNV9Y5W8",
      "associatedDomains": [
        "applinks:sinsincare.kr"
      ],
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "신신당부",
        "CFBundleName": "신신당부",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram",
          "kakaokompassauth",
          "kakaolink",
          "kakaotalk"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D8E9F5"
      },
      "package": "com.mediology.sinsinapp",
      "versionCode": 19,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sinsincare.kr",
              "pathPrefix": "/password-edit"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5A5F",
          "androidMode": "default",
          "androidCollapsedTitle": "신신당부 알림"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "음식 사진을 촬영하기 위해 카메라 접근이 필요합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "음식 사진을 선택하기 위해 사진 접근이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.87899379852-eo6mf97djcrckpbqc748vcdcbl2m3ls4"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "709c22f6c6227095a316851f1f902189",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "kakaotalkLoginEnabled": true,
            "handleKakaoOpenUrl": true
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.6",
            "appleTeamId": "HJJNV9Y5W8",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ],
            "configurations": {
              "Debug": {
                "prebuild": "Debug"
              },
              "Release": {
                "prebuild": "Release"
              }
            }
          },
          "android": {
            "newArchEnabled": true,
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 추천 식당과 현재 위치(동·구)를 표시하기 위해 위치 정보를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-localization"
    ],
    "scheme": "sinsin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd9b5694-69b9-43b8-bc38-f3c0c4366183"
      }
    },
    "owner": "mediologyadmin"
  }
}
