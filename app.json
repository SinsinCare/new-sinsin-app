{
  "expo": {
    "name": "신신당부",
    "slug": "sinsin-rn",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "buildNumber": "2",
      "bundleIdentifier": "com.mediology.sinsin-care",
      "appleTeamId": "HJJNV9Y5W8",
      "deploymentTarget": "18.6",
      "associatedDomains": [
        "applinks:sinsin.mediology.ai"
      ],
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AI 상담원과의 음성 대화를 위해 마이크 접근 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram",
          "kakaokompassauth",
          "kakaolink",
          "kakaotalk"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.mediology.sinsinapp",
      "edgeToEdgeEnabled": true,
      "minSdkVersion": 23,
      "targetSdkVersion": 34,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sinsin.mediology.ai",
              "pathPrefix": "/password-edit"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5A5F",
          "androidMode": "default",
          "androidCollapsedTitle": "신신당부 알림"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "음식 사진을 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "음식 사진을 선택하기 위해 사진 접근이 필요합니다."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.87899379852-eo6mf97djcrckpbqc748vcdcbl2m3ls4"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "8a0c04712b7195a565dd74c5897a1510",
          "android": {
            "kakaotalkLoginEnabled": true
          },
          "ios": {
            "kakaotalkLoginEnabled": true
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.6",
            "appleTeamId": "HJJNV9Y5W8",
            "configurations": {
              "Debug": {
                "prebuild": "Debug"
              },
              "Release": {
                "prebuild": "Release"
              }
            }
          },
          "android": {
            "newArchEnabled": false,
            "extraMavenRepos": [
              "https://devrepo.kakao.com/nexus/content/groups/public/"
            ]
          }
        }
      ]
    ],
    "scheme": "sinsin",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "40c02a9a-5bfa-42f1-84db-85faa562f011"
      }
    }
  }
}
